<Window x:Class="StretchMyIcons.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="stretch-my-icons" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        SizeToContent="WidthAndHeight" Loaded="WindowLoaded">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="#35FFFFFF"
            BorderThickness="1" CornerRadius="10" Padding="8">
        <StackPanel>
            <DockPanel Margin="4,2,4,8">
                <TextBlock Text="stretch-my-icons" Foreground="{StaticResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold" />
                <Button DockPanel.Dock="Right" Content="×" Click="CloseClicked"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                        FontSize="16" Padding="4,0" ToolTip="Close" />
            </DockPanel>
            <WrapPanel x:Name="TilePanel" />
            <DockPanel Margin="4,8,4,0">
                <TextBlock Text="Grid" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <ComboBox x:Name="GridPicker" Width="72" Margin="8,0,0,0" SelectedIndex="0"
                          SelectionChanged="GridChanged">
                    <ComboBoxItem Content="1×1" Tag="1,1" />
                    <ComboBoxItem Content="1×2" Tag="1,2" />
                    <ComboBoxItem Content="2×1" Tag="2,1" />
                    <ComboBoxItem Content="2×2" Tag="2,2" />
                    <ComboBoxItem Content="1×3" Tag="1,3" />
                    <ComboBoxItem Content="3×1" Tag="3,1" />
                </ComboBox>
                <TextBlock Text="desktop shortcuts" Foreground="{StaticResource MutedBrush}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
